PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Who receives inquiry emails
DESIGNER_EMAIL=designer@example.com

# Where the frontend is served (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# SMTP — optional; if unset, inquiries are still saved to DB but no email is sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin dashboard shared-secret (any long random string)
ADMIN_TOKEN=

# Public site URL (used by /sitemap.xml and /robots.txt)
PUBLIC_SITE_URL=http://localhost:5173

# When true, Express trusts X-Forwarded-For (set to true on Render/Heroku/behind a proxy)
TRUST_PROXY=false
